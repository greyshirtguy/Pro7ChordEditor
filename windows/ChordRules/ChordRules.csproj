<!--
  ChordRules: the rules. What a chord's name is, keys, moving a chord to another key,
  the four notations, what is offered as a chord is typed, a text box's chords in order
  and as the file writes them, chords as ChordPro text, the words of an RTF, which key
  a song is likely in (spec/02-chord-rules.md, and the words of spec/01-file-format.md).

  Plain functions over text and numbers. Nothing here knows of a file or a window, and
  the project is so made that it cannot come to: it is built for plain .NET, where
  there is no WPF to reach for, and it names no package, so there is no protobuf
  either. Keep it so.

  Its tests are Tests/ChordRules.Tests, held to testdata/vectors: the code is right
  when it gives those answers (AGENTS.md, "The rules are the vectors"). They may see
  what is kept inside the project (the last lines of this file), so that the few small
  things the rules stand on can be tried by themselves: what white space is, how a
  score is rounded, which bytes of an RTF a line is written with.

  Chords.cs is the way in, and lists the files.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Pro7ChordEditor.ChordRules</AssemblyName>
    <RootNamespace>Pro7ChordEditor.ChordRules</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pro7ChordEditor.ChordRules.Tests" />
  </ItemGroup>
</Project>
