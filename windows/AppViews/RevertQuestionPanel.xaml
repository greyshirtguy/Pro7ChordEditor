<!--
  What Revert asks before it does anything, over the window while it is asking.
  spec/06-library.md, rule 12a:

      Revert "the song's name" to how it was when it was opened?
      This takes back EVERY change made to this song since it was opened in this
      editor.
                                        [ Revert All Changes ]  [ Cancel ]

  Cancel is what Esc and Enter give: Enter is not to be what throws an hour's work
  away. A click on the dimmed window behind is Cancel too.

  It is drawn in the window, as the earlier versions are, and is not a window of the
  system's: the system's own asks with buttons it names itself, Yes or OK, and this
  one's button is to say what it does. The words are LibraryModel's.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.RevertQuestionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.DirectionalNavigation="Cycle">
  <Grid>
    <Border Background="#73000000" MouseLeftButtonDown="OutsideWasClicked" />
    <Border MaxWidth="470"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="36"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Background="{DynamicResource ApplicationBackgroundBrush}">
      <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" Margin="0,10,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button x:Name="Yes" Click="YesWasClicked" />
          <Button x:Name="Cancel" Content="Cancel" Margin="8,0,0,0" IsDefault="True" IsCancel="True" Click="CancelWasClicked" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
