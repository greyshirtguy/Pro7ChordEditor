<!--
  Chords, in the app's settings: the colour of a chord's name on the chord sheet, the
  colour of the highlighted line of the sheet, and the colour of a chord in the
  ChordPro text; and last, whether the sheet draws sharps and flats as the music
  signs (spec/06-library.md, rule 20a).

  Each has a well that shows the colour and opens the system's colour picker when it is
  clicked; a button, "Usual Colour", that puts back the one the app comes with; and
  beside them what it will look like: a chord's name in a bubble over a word, as the
  sheet draws one; two lines of words, the second in the highlighted line's colour;
  and a line of ChordPro with its chords in their colour, bold.

  The highlighted line is the line the pointer is on, on the chord sheet
  (spec/03-chord-sheet.md, rule 53f). Under its name it says what it is, in the page's
  words, with Windows' keys.

  The sheet's two samples are on the sheet's own dark card, whatever the system's look
  is, since the sheet is. The text's is on the window's ground, which is the look's.

  The switch for the signs is on as the app comes. Beside it, three chords in their
  bubbles as the sheet then draws them (spec/03-chord-sheet.md, rule 10a).

  The page scrolls where the window is too short for it: with the switch it is taller
  than the settings' window was as it opened, and the window can be made shorter yet.

  Nothing here touches a song. A colour is only how this app draws a chord: it is kept
  with the app's own settings, and nothing in a song's file says one. Nor is a sign:
  songs are saved with # and b either way.

  What is shown comes from LibraryModel, which this view is handed. It has a ground of
  its own and says what colour words are, both the system's: a test draws it with no
  window to have them from.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.ChordColourSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             UseLayoutRounding="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <StackPanel Margin="14,12,14,14" Width="560" HorizontalAlignment="Left" VerticalAlignment="Top">
    <TextBlock Text="Chords" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2" />
    <TextBlock Text="The colour chords are drawn in, in each of the two editors, the colour of the line the pointer is on, and how the chord sheet draws sharps and flats."
               TextWrapping="Wrap"
               Margin="0,4,0,18"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="On the chord sheet" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="SheetWell"
                  Padding="4"
                  Click="ChooseTheSheets"
                  ToolTip="Choose the colour of a chord&#x2019;s name on the chord sheet."
                  AutomationProperties.Name="The colour of a chord on the chord sheet">
            <Border x:Name="SheetColour" Width="40" Height="20" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
          </Button>
          <Button x:Name="SheetUsual"
                  Content="Usual Colour"
                  Margin="10,0,0,0"
                  Click="TheSheetsUsual"
                  ToolTip="Put this colour back to the one the app comes with."
                  ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
      </StackPanel>
      <!-- A chord as the sheet draws one: its name in a bubble, over a word. -->
      <Border Grid.Column="1" Width="190" Background="#222428" CornerRadius="4" Padding="10" Margin="12,0,0,0">
        <StackPanel HorizontalAlignment="Left">
          <Border Background="#34363C" BorderBrush="#5C5F66" BorderThickness="1" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left">
            <TextBlock x:Name="SheetSample" Text="Em7" FontSize="13" FontWeight="Bold" />
          </Border>
          <TextBlock Text="Amazing grace" FontSize="17" Foreground="#E6E6E6" Margin="0,3,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="The highlighted line" FontWeight="SemiBold" />
        <TextBlock x:Name="LineSays"
                   Text="The line the pointer is on, on the chord sheet: where Ctrl+C copies from and Ctrl+V pastes to."
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="LineWell"
                  Padding="4"
                  Click="ChooseTheLines"
                  ToolTip="Choose the colour of the highlighted line on the chord sheet."
                  AutomationProperties.Name="The colour of the highlighted line on the chord sheet">
            <Border x:Name="LineColour" Width="40" Height="20" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
          </Button>
          <Button x:Name="LineUsual"
                  Content="Usual Colour"
                  Margin="10,0,0,0"
                  Click="TheLinesUsual"
                  ToolTip="Put this colour back to the one the app comes with."
                  ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
      </StackPanel>
      <!-- Two lines as the sheet draws them, the second the highlighted one. -->
      <Border Grid.Column="1" Width="190" Background="#222428" CornerRadius="4" Padding="10" Margin="12,0,0,0" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Left">
          <TextBlock Text="Amazing grace" FontSize="17" Foreground="#E6E6E6" />
          <TextBlock x:Name="LineSample" Text="How sweet the sound" FontSize="17" Margin="0,3,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="In ChordPro text" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="TextWell"
                  Padding="4"
                  Click="ChooseTheTexts"
                  ToolTip="Choose the colour of a chord in ChordPro text."
                  AutomationProperties.Name="The colour of a chord in ChordPro text">
            <Border x:Name="TextColour" Width="40" Height="20" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
          </Button>
          <Button x:Name="TextUsual"
                  Content="Usual Colour"
                  Margin="10,0,0,0"
                  Click="TheTextsUsual"
                  ToolTip="Put this colour back to the one the app comes with."
                  ToolTipService.ShowOnDisabled="True" />
        </StackPanel>
      </StackPanel>
      <!-- A line as the text shows one: the chords in their colour, bold, among the words. -->
      <Border Grid.Column="1"
              Width="190"
              CornerRadius="4"
              Padding="10"
              Margin="12,0,0,0"
              BorderThickness="1"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
        <TextBlock FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13">
          <Run x:Name="TextSampleOne" Text="[Em7]" FontWeight="Bold" /><Run Text="Amazing " /><Run x:Name="TextSampleTwo" Text="[D]" FontWeight="Bold" /><Run Text="grace" />
        </TextBlock>
      </Border>
    </Grid>

    <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <CheckBox x:Name="Signs" Click="SignsWereClicked">
          <TextBlock Text="Show sharps and flats as &#x266F; and &#x266D;" FontWeight="SemiBold" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock Text="On the chord sheet. Songs are saved with # and b either way."
                   TextWrapping="Wrap"
                   Margin="28,6,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <!-- Three chords as the sheet then draws them, each in its bubble (the code beside this fills it). -->
      <Border Grid.Column="1" Width="190" Background="#222428" CornerRadius="4" Padding="10" Margin="12,0,0,0" VerticalAlignment="Center">
        <StackPanel x:Name="SignsSamples" Orientation="Horizontal" HorizontalAlignment="Left" />
      </Border>
    </Grid>

    <TextBlock Text="These are only how chords look in this app. Nothing in a song&#x2019;s file says a colour, and ProPresenter shows chords in its own."
               TextWrapping="Wrap"
               Margin="0,20,0,0"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
