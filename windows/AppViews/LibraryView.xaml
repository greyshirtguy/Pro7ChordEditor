<!--
  What the window holds: one view. spec/06-library.md, "The window".

    across the top  the window's own menu, kept to what the app has a use for
                    (spec/10-platforms.md, "Menus");
    at the left     two lists, one over the other, as ProPresenter has them: the place
                    and its libraries, and under them the songs of the library chosen
                    (ListsPane);
    at the right    the song that is open (SongPane);
    over it all     while it is asked for, the song's earlier versions
                    (EarlierVersionsPanel); and while Revert is asking, its question
                    (QuestionPanel).

  The menu. File has what is done to the library and to the song's file, and Revert,
  as in the window. THERE IS NO SAVE IN IT (spec/06, rule 12a: "It is in no menu";
  the maintainer, 2026-10-13, of the Mac's: "I am guessing the save menu is not
  needed". A Save in a menu says there is saving to do, and here every change is saved
  as it is made). Ctrl+S, pressed out of habit, is answered still, by the view. Edit
  has what a box of text takes, each sent to whatever has the keyboard: in the
  ChordPro text, Undo and Redo are the text's own (spec/04, rule 23); on the chord
  sheet they are the song's, and Copy and Paste are of a line's chords (spec/03, rules
  47 to 53). Help has the guide, and what the app is.

  (Until 2026-10-14 there were two menus more, View and Song. View had the two
  editors and the size of the words, each of which has its buttons in the window and
  its keys, which those buttons' tips say; Song had Earlier Versions, which is the
  blue button in the song's header. The Mac's menus were kept to what is of use on
  2026-10-13, "lets clean up the menus", and have neither; and the page says Windows
  has the same commands in the window's own menu.)

  The edge between the lists and the song is a bar that is seen, of the colour of the
  bar between the two lists and with a small grip in its middle as that has. It is
  dragged sideways, to give either more width; clicked twice, it goes back to where it
  starts, half way between the least and the most the lists can be; and where it is
  left is remembered (spec/06, rule 6a). How wide the lists then are in a window of a
  given width is ListsLook's arithmetic, which the code beside this asks whenever the
  window's width changes: they keep their width as the window is made wider or
  narrower, the song having the difference.

  It is WPF's own thing for dragging between two columns, which starts where it is
  told to and changes no width but as it is dragged. (The Mac's own split view did
  neither, and the edge there is the app's.) It is drawn here and not by the look, so
  that it is the same bar in every look; every point of its width takes the mouse, and
  the pointer is the one for dragging sideways the moment it is over it.

  Nothing here is a rule. What is shown comes from LibraryModel, which this view is
  handed, and what the person does is passed on to it.

  It is a view of its own and not written into the window, so that a test can draw it
  into a picture without a window being opened (spec/10-platforms.md). It has a ground
  of its own and says what colour words are, both the system's: drawn into a picture
  it is under no window to have them from.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pro7ChordEditor.AppViews"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             UseLayoutRounding="True"
             PreviewKeyDown="AKeyWasPressed">
  <Grid>
    <DockPanel>
      <Menu DockPanel.Dock="Top" FontSize="13">
        <MenuItem Header="_File" SubmenuOpened="TheFileMenuWasOpened">
          <MenuItem Header="Choose _Folder&#x2026;" Click="ChooseAFolder" />
          <Separator />
          <MenuItem x:Name="BringIn" Header="_New Song from ChordPro File&#x2026;" Click="BringInAFile" />
          <MenuItem x:Name="WriteOut" Header="Save Song as _ChordPro File&#x2026;" Click="WriteAChordProFile" />
          <Separator />
          <MenuItem x:Name="Revert" Header="_Revert to as Opened&#x2026;" Click="AskToRevert" />
          <Separator />
          <MenuItem Header="Se_ttings&#x2026;" Click="OpenTheSettings" />
          <Separator />
          <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="CloseTheWindow" />
        </MenuItem>
        <MenuItem Header="_Edit">
          <MenuItem Command="ApplicationCommands.Undo" />
          <MenuItem Command="ApplicationCommands.Redo" />
          <Separator />
          <MenuItem Command="ApplicationCommands.Cut" />
          <MenuItem Command="ApplicationCommands.Copy" />
          <MenuItem Command="ApplicationCommands.Paste" />
          <Separator />
          <MenuItem Command="ApplicationCommands.SelectAll" />
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem x:Name="TheGuide" Header="Pro7 Chord Editor _Guide" InputGestureText="F1" Click="ShowTheGuide" />
          <Separator />
          <MenuItem x:Name="About" Header="_About Pro7 Chord Editor" Click="ShowAbout" />
        </MenuItem>
      </Menu>
      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="Lists" Width="345" MinWidth="210" MaxWidth="480" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>
        <views:ListsPane x:Name="Listed" Grid.Column="0" />
        <!-- The edge: a bar of the colour of the bar between the two lists, with a small grip in its middle as that has. -->
        <GridSplitter x:Name="Edge"
                      Grid.Column="1"
                      Width="8"
                      MinWidth="8"
                      Padding="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Cursor="SizeWE"
                      Focusable="False"
                      DragCompleted="TheEdgeWasDragged"
                      MouseDoubleClick="TheEdgeWasClickedTwice"
                      ToolTip="Drag left or right to give the lists or the song more room. Click twice to put it back where it starts.">
          <GridSplitter.Template>
            <ControlTemplate TargetType="GridSplitter">
              <Border Background="{DynamicResource Pro7.Bar}">
                <Border x:Name="EdgeGrip"
                        Width="4"
                        Height="30"
                        CornerRadius="2"
                        Opacity="0.28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource TextFillColorPrimaryBrush}" />
              </Border>
            </ControlTemplate>
          </GridSplitter.Template>
        </GridSplitter>
        <views:SongPane x:Name="Song" Grid.Column="2" />
      </Grid>
    </DockPanel>
    <views:EarlierVersionsPanel Visibility="Collapsed" />
    <views:QuestionPanel x:Name="Asking" Visibility="Collapsed" />
    <views:MendAllPanel x:Name="MendAll" Visibility="Collapsed" />
    <views:NewSongPanel x:Name="NewSong" Visibility="Collapsed" />
  </Grid>
</UserControl>
