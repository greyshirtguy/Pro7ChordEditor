<!--
  What the window holds: one view. spec/06-library.md, "The window".

    across the top  the window's own menu, with every command in it
                    (spec/10-platforms.md, "Menus");
    at the left     two lists, one over the other, as ProPresenter has them: the place
                    and its libraries, and under them the songs of the library chosen
                    (ListsPane);
    at the right    the song that is open (SongPane);
    over it all     while it is asked for, the song's earlier versions
                    (EarlierVersionsPanel); and while Revert is asking, its question
                    (RevertQuestionPanel).

  The menu. File has what is done to the library and to the song's file: Save, for the
  hand that goes to it out of habit, though nothing is saved by hand here, and Revert
  beside it, as in the window (spec/06, rule 12a). Edit has what a box of text takes,
  each sent to whatever has the keyboard: in the ChordPro text, Undo and Redo are the
  text's own (spec/04, rule 23); on the chord sheet they are the song's, and Copy and
  Paste are of a line's chords (spec/03, rules 47 to 53). View has the two editors,
  the one that is shown ticked, and the size of the words in it.

  The edge between the lists and the song is dragged sideways, to give either more
  width. How wide the lists then are in a window of a given width is ListsLook's
  arithmetic, which the code beside this asks whenever the window's width changes.

  Nothing here is a rule. What is shown comes from LibraryModel, which this view is
  handed, and what the person does is passed on to it.

  It is a view of its own and not written into the window, so that a test can draw it
  into a picture without a window being opened (spec/10-platforms.md). It has a ground
  of its own and says what colour words are, both the system's: drawn into a picture
  it is under no window to have them from.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pro7ChordEditor.AppViews"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             UseLayoutRounding="True"
             PreviewKeyDown="AKeyWasPressed">
  <Grid>
    <DockPanel>
      <Menu DockPanel.Dock="Top" FontSize="13">
        <MenuItem Header="_File" SubmenuOpened="TheFileMenuWasOpened">
          <MenuItem Header="Choose _Folder&#x2026;" Click="ChooseAFolder" />
          <Separator />
          <MenuItem x:Name="Save" Header="_Save" InputGestureText="Ctrl+S" Click="SaveNow" />
          <MenuItem x:Name="Revert" Header="_Revert to as Opened&#x2026;" Click="AskToRevert" />
          <Separator />
          <MenuItem Header="Se_ttings&#x2026;" Click="OpenTheSettings" />
          <Separator />
          <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="CloseTheWindow" />
        </MenuItem>
        <MenuItem Header="_Edit">
          <MenuItem Command="ApplicationCommands.Undo" />
          <MenuItem Command="ApplicationCommands.Redo" />
          <Separator />
          <MenuItem Command="ApplicationCommands.Cut" />
          <MenuItem Command="ApplicationCommands.Copy" />
          <MenuItem Command="ApplicationCommands.Paste" />
          <Separator />
          <MenuItem Command="ApplicationCommands.SelectAll" />
        </MenuItem>
        <MenuItem Header="_View" SubmenuOpened="TheViewMenuWasOpened">
          <MenuItem x:Name="ShowChords" Header="_Chords" InputGestureText="Ctrl+1" Click="ShowTheSheet" />
          <MenuItem x:Name="ShowChordPro" Header="Chord_Pro" InputGestureText="Ctrl+2" Click="ShowTheText" />
          <Separator />
          <MenuItem x:Name="LargerWords" Header="_Larger" InputGestureText="Ctrl+Plus" Click="MakeTheWordsLarger" />
          <MenuItem x:Name="SmallerWords" Header="_Smaller" InputGestureText="Ctrl+Minus" Click="MakeTheWordsSmaller" />
          <MenuItem x:Name="UsualWords" Header="_Usual Size" InputGestureText="Ctrl+0" Click="MakeTheWordsTheirUsualSize" />
        </MenuItem>
        <MenuItem Header="_Song" SubmenuOpened="TheSongMenuWasOpened">
          <MenuItem x:Name="EarlierVersions" Header="_Earlier Versions&#x2026;" Click="ShowEarlierVersions" />
        </MenuItem>
      </Menu>
      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="Lists" Width="270" MinWidth="210" MaxWidth="480" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>
        <views:ListsPane x:Name="Listed" Grid.Column="0" />
        <!-- The edge. It is the bar's colour, and has the look's own small grip in its middle. -->
        <GridSplitter x:Name="Edge"
                      Grid.Column="1"
                      Width="5"
                      MinWidth="5"
                      Padding="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Background="{DynamicResource Pro7.Bar}"
                      Focusable="False"
                      DragCompleted="TheEdgeWasDragged"
                      ToolTip="Drag left or right to give the lists or the song more room." />
        <views:SongPane x:Name="Song" Grid.Column="2" />
      </Grid>
    </DockPanel>
    <views:EarlierVersionsPanel Visibility="Collapsed" />
    <views:RevertQuestionPanel Visibility="Collapsed" />
    <views:MendAllPanel x:Name="MendAll" Visibility="Collapsed" />
  </Grid>
</UserControl>
