<!--
  The app's one window (spec/06-library.md, "The window"). At the left the libraries
  and, under them, the songs of the one chosen; at the right the song.

  A window only frames what is in it, and what is in it is a view of its own
  (LibraryView), never something written straight into this file: a test draws a view
  into a picture without any window being opened, and so can only draw what is a view.
  The view is put in by the code beside this, which hands it its model.

  It opens at 1280 by 800, as the Mac app's does.
-->
<Window x:Class="Pro7ChordEditor.AppViews.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pro7 Chord Editor"
        Width="1280"
        Height="800"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterScreen" />
