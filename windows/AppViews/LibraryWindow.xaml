<!--
  The app's one window (spec/06-library.md, "The window"). It is named for what it is
  to be, as the Mac app's is: at the left the libraries and, under them, the songs of
  the one chosen; at the right the song. Until milestone M3 it holds NotBuiltYet and
  nothing else.

  A window only frames what is in it, and what is in it is always a view of its own
  (here NotBuiltYet), never something written straight into this file: a test draws a
  view into a picture without any window being opened, and so can only draw what is a
  view.

  It opens at 1280 by 800, as the Mac app's does.
-->
<Window x:Class="Pro7ChordEditor.AppViews.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pro7ChordEditor.AppViews"
        Title="Pro7 Chord Editor"
        Width="1280"
        Height="800"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <views:NotBuiltYet />
</Window>
