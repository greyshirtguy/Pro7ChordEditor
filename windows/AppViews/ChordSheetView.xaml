<!--
  The chord sheet in the song's pane: a strip across its top, and under it the sheet
  itself (ChordSheetCanvas.cs), seen through something that scrolls it both ways
  (spec/03-chord-sheet.md, rules 14 and 14a).

    the strip   the key's own chords on the keys 1 to 7, which can be clicked there too;
                and at its right the two buttons that make the words smaller and larger.
                The key itself is set in the song's header, over this, and nowhere else.
                Nothing in the strip is ever squeezed or wrapped: where the pane is too
                narrow for the chords and what is said of a song with no key, that is
                left out; and where it is too narrow for the chords, they scroll
                sideways (the wheel does it);
    the sheet   every slide of the song, drawn.

  It is dark whatever the system is, as the sheet is on both platforms
  (spec/10-platforms.md): so the colours here are the sheet's own (SheetLook.cs), the
  buttons' looks are this file's, and what scrolls the sheet wears the dark look, for
  its scroll bars (the code beside this).

  The bar that scrolls the sheet down is always there. How many slides go to a row is
  worked out from how wide the sheet is seen to be, and a bar that came and went with
  the song's length would change that width as it did.

  None of the buttons takes the keyboard when it is clicked: a click on one of the key's
  chords while a chord is being typed puts that chord in place of what was typed, and a
  button that took the keyboard from the box would have ended the typing first.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.ChordSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pro7ChordEditor.AppViews"
             Background="#1B1C1F">
  <UserControl.Resources>
    <!-- One of the key's chords: its number, quiet, and its name. -->
    <Style x:Key="OfTheKey" TargetType="Button">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Ground" CornerRadius="6" Background="#3A3C42">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ground" Property="Background" Value="#474950" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Ground" Property="Background" Value="#303237" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- One of the two that zoom: a round button with a minus or a plus drawn in it. -->
    <Style x:Key="Round" TargetType="Button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Ground" Fill="#3A3C42" />
              <ContentPresenter x:Name="Sign" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ground" Property="Fill" Value="#474950" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Ground" Property="Fill" Value="#303237" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Sign" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <Border x:Name="Strip" DockPanel.Dock="Top" Height="44" Padding="14,0" Background="#202226">
      <DockPanel LastChildFill="True">
        <StackPanel x:Name="Zoom" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <Button x:Name="Smaller"
                  Style="{StaticResource Round}"
                  Click="SmallerWasClicked"
                  ToolTip="Smaller words, and more slides in view. Ctrl with the minus key does the same."
                  AutomationProperties.Name="Smaller words">
            <Path Data="M0,4 L8,4" Width="8" Height="8" Stroke="#E6E6E6" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
          <Button x:Name="Larger"
                  Style="{StaticResource Round}"
                  Margin="6,0,0,0"
                  Click="LargerWasClicked"
                  ToolTip="Larger words. Ctrl with the plus key does the same; Ctrl with 0 is the usual size."
                  AutomationProperties.Name="Larger words">
            <Path Data="M0,4 L8,4 M4,0 L4,8" Width="8" Height="8" Stroke="#E6E6E6" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>
        <TextBlock x:Name="NoKey"
                   DockPanel.Dock="Right"
                   Text="The song names no key: pick the one its chords are in"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="12"
                   Foreground="#8D9097"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />
        <ScrollViewer x:Name="ChordsSeen"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Left"
                      Focusable="False"
                      PreviewMouseWheel="TheWheelTurnedOverTheChords">
          <StackPanel x:Name="Chords" Orientation="Horizontal" VerticalAlignment="Center" />
        </ScrollViewer>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="Scroll"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Visible"
                  Focusable="False"
                  Background="#1B1C1F">
      <views:ChordSheetCanvas x:Name="Sheet" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
