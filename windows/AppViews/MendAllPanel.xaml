<!--
  Mend All, over the window from the question to the last of what it did.
  spec/08-repair.md, "The whole library": it "says first how many songs and chords,
  copies every file it will change, and says afterwards what it did, by name".

      Mend 12 songs?
      148 chords in them are written so that ProPresenter shows them twice. Each is
      written again where it stands: no chord is moved, and no name is changed. A copy
      of each song is kept first.
                                             [ Mend 12 Songs ]  [ Cancel ]

  then, while it is at work, how far it has got and what it has done so far, with Stop,
  which lets the song it is at be finished and begins no more; and then

      12 songs were mended: 148 chords that ProPresenter showed twice.
        Amazing Grace (Chords)                                    6 chords
        It Is Well (Chords)                                       4 chords
        ...
                                                                  [ Done ]

  A song that was not mended says why under its name.

  Nothing else in the window can be reached while it is there: the window behind is
  dimmed, and a click on it does nothing but, before the work is begun, say no. Cancel
  is what Esc and Enter give at the question, as at Revert's.

  It is drawn in the window, as the earlier versions are. The words are LibraryModel's
  (LibraryModel.Mending.cs).
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.MendAllPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.DirectionalNavigation="Cycle">
  <Grid>
    <Border Background="#73000000" MouseLeftButtonDown="OutsideWasClicked" />
    <Border MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="36"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Background="{DynamicResource ApplicationBackgroundBrush}">
      <DockPanel Margin="20,18,20,16" LastChildFill="True">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" DockPanel.Dock="Top" Margin="0,10,0,0" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button x:Name="Yes" Click="YesWasClicked" />
          <Button x:Name="Other" Margin="8,0,0,0" IsDefault="True" IsCancel="True" Click="TheOtherWasClicked" />
        </StackPanel>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="4" Margin="0,14,0,0" Minimum="0" />
        <ScrollViewer x:Name="DoneSeen" Margin="0,12,0,0" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel x:Name="Done" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
