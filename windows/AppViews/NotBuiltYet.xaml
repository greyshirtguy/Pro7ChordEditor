<!--
  What the window shows until there is a library to show (milestone M3): the app's
  name, and a sentence that says there is nothing here yet. It is here so that
  milestone M0 has something to draw into a picture and something to see when the app
  is started. It goes when the library's lists and the song take its place.

  It has a ground of its own, the system's colour for a window. Drawn into a picture
  with none, it would be see-through, and a see-through picture shows as black or as
  white by the whim of whatever opens it.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.NotBuiltYet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Pro7 Chord Editor"
               FontSize="28"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
    <TextBlock Text="The Windows app is being built. There is nothing to open here yet."
               Margin="0,12,0,0"
               FontSize="14"
               HorizontalAlignment="Center"
               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
  </StackPanel>
</UserControl>
