<!--
  The song that is open, at the right of the window: its name, the switch between its
  two editors (EditorSwitch.xaml), its two keys, and the editor that is shown: the chord
  sheet (ChordSheetView.xaml) or the song as ChordPro text to be typed in
  (ChordProText.xaml). spec/06-library.md, rules 12, 12a, 14 and 19;
  spec/03-chord-sheet.md; spec/04-chordpro-editor.md; spec/05-song-and-saving.md, rules
  5 to 7; spec/07-backups.md, rules 15, 22 and 22a.

    a band     across the top while ProPresenter is running: everything can be looked
               at and nothing changed. It goes by itself when ProPresenter does;
    a header   the song's name at the left; the switch between the two editors in the
               middle; at the right Earlier Versions, if copies of it are kept, and its
               two keys, each to be set. Where the pane is too narrow for the name to
               be read beside them, the keys go on a row of their own under it, and
               where even that is too wide each has a row (SongLook.cs);
    offers     under the header, a row for each thing found in the song that wants
               mending (spec/08-repair.md): a sentence that says what, and at its right
               the button that puts it right. None for most songs;
    the song   on the chord sheet, under the strip of its key's chords and over the
               line of hints, which says what the keys do where the pointer is
               (ChordSheetView.xaml has all three); or as ChordPro
               text, under a line of help (or, in a warmer colour, why this song can be
               read there and not changed) with the size of the text at its right: a
               small letter A and a large one; or the sentence that says why it could
               not be read; or, with no song open, a few quiet words where it would be;
    a line     at the foot, the quiet line, that says how much there is of the song
               ("7 slides, 40 chords."), for a few seconds what just happened, or what
               went wrong. (Until 2026-10-13 it also said, while the sheet was shown,
               what the keys do, all of it in one sentence of up to four lines.) After
               a version has been put back it
               offers, for a few seconds, to undo that; and after a file was found
               changed by something else, to open the song again. At its right end:
               Revert, and where a Save button would be, the words that say why there
               is none.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.SongPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pro7ChordEditor.AppViews"
             Background="{DynamicResource ApplicationBackgroundBrush}">
  <DockPanel>
    <Border x:Name="Band" DockPanel.Dock="Top" Background="{DynamicResource Pro7.Band}" Padding="10,6">
      <TextBlock x:Name="BandWords" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    </Border>

    <Border x:Name="Foot" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="12,5,12,6">
      <DockPanel LastChildFill="True">
        <StackPanel x:Name="Saving" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Revert"
                  Content="Revert&#x2026;"
                  Margin="10,0,0,0"
                  Padding="9,2,9,3"
                  Click="RevertWasClicked"
                  ToolTip="Take back every change made to this song since it was opened here, after asking. What the song is now is kept as an earlier version first."
                  ToolTipService.ShowOnDisabled="True" />
          <TextBlock x:Name="Autosave"
                     Margin="10,0,0,0"
                     FontSize="12"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <!--
          What the line says, and beside it what it offers. (Kept to the left, and as
          wide as they are together: so the offer stands just after the words, and where
          the words are too long for the line it is the words that are cut short.)
        -->
        <DockPanel HorizontalAlignment="Left" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="OpenAgain"
                    Content="Open Again"
                    Margin="10,0,0,0"
                    Padding="9,2,9,3"
                    Click="OpenAgainWasClicked"
                    ToolTip="Read the song again from its file, as it is now." />
            <Button x:Name="Undo"
                    Content="Undo"
                    Margin="10,0,0,0"
                    Padding="9,2,9,3"
                    Click="UndoWasClicked"
                    ToolTip="Put the song back as it was a moment ago." />
          </StackPanel>
          <TextBlock x:Name="Quiet" FontSize="12.5" VerticalAlignment="Center" Margin="0,1,0,1" />
        </DockPanel>
      </DockPanel>
    </Border>

    <!--
      The header. On one row: the name, the switch in the middle of the pane, and at
      the right Earlier Versions and the keys. Where that would cut the name short: the
      name and the switch over the keys, with Earlier Versions at the right of the
      keys' row. Where even that is too wide: the name with Earlier Versions, the
      switch, and the keys, a row each. The code beside this moves them.
    -->
    <Grid x:Name="Header" DockPanel.Dock="Top" Margin="16,10,16,10">
      <!--
        Five columns: the name's; the switch's; what is left over, on the one row; Earlier
        Versions'; the keys'. Everything but the name is in a column as wide as itself, or
        lies across them all: nothing but the name is ever given less room than it needs.
      -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="SongName" FontSize="20" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <views:EditorSwitch x:Name="Editors" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <Button x:Name="Earlier"
              Grid.Column="3"
              Content="Earlier Versions"
              Margin="14,0,0,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Click="EarlierVersionsWasClicked"
              ToolTip="See this song as it was before it was changed here, and put a version back." />
      <StackPanel x:Name="Keys" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <TextBlock Text="Key" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox x:Name="Key"
                  MinWidth="72"
                  MaxDropDownHeight="420"
                  VerticalAlignment="Center"
                  SelectionChanged="AKeyWasPicked"
                  ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Key" />
        <TextBlock Text="Shown in"
                   VerticalAlignment="Center"
                   Margin="14,0,6,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ComboBox x:Name="ShownKey"
                  MinWidth="72"
                  MaxDropDownHeight="420"
                  VerticalAlignment="Center"
                  SelectionChanged="AShownKeyWasPicked"
                  ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Shown in" />
      </StackPanel>
    </Grid>
    <Border x:Name="UnderTheHeader" DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <!-- (Its rows are made in the code beside, from the model's offers.) -->
    <StackPanel x:Name="Offers" DockPanel.Dock="Top" />

    <Grid>
      <TextBlock x:Name="NoSong"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="Problem" Margin="16" TextWrapping="Wrap" VerticalAlignment="Top" />
      <DockPanel x:Name="Editor">
        <Border DockPanel.Dock="Top" Padding="16,6,12,6">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
              <Button x:Name="Smaller"
                      Content="A"
                      FontSize="10.5"
                      FontWeight="SemiBold"
                      Width="28"
                      Height="24"
                      Padding="0"
                      Click="SmallerWasClicked"
                      ToolTip="Smaller text. Ctrl with the minus key does the same."
                      ToolTipService.ShowOnDisabled="True"
                      AutomationProperties.Name="Smaller text" />
              <Button x:Name="Larger"
                      Content="A"
                      FontSize="15"
                      FontWeight="SemiBold"
                      Width="28"
                      Height="24"
                      Padding="0"
                      Margin="4,0,0,0"
                      Click="LargerWasClicked"
                      ToolTip="Larger text. Ctrl with the plus key does the same; Ctrl with 0 is the usual size."
                      ToolTipService.ShowOnDisabled="True"
                      AutomationProperties.Name="Larger text" />
            </StackPanel>
            <TextBlock x:Name="Help" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <views:ChordProText x:Name="Text" />
      </DockPanel>
      <views:ChordSheetView x:Name="SheetView" Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</UserControl>
