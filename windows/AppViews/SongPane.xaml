<!--
  The song that is open, at the right of the window: its name, its key, and its lines
  with their chords in brackets. So far (milestone M3) it is only shown.
  spec/06-library.md, rules 12, 14 and 19; the ChordPro editor (M5) and the chord sheet
  (M6) take the place of the lines, and the two keys become pickers then.

    a band     across the top while ProPresenter is running: everything can be looked
               at and nothing changed. It goes by itself when ProPresenter does;
    a header   the song's name, and at its right the key it states, if it states one;
    the song   its lines, or the sentence that says why it could not be read, or, with
               no song open, a few quiet words where it would be;
    a line     at the foot, that says what is there to be seen.

  The lines are made in the code beside this, from the model's: a group's name before
  its first slide, a gap between slides, each line of words with its chords before the
  characters they stand over. Chords are orange, brackets and all, as
  spec/04-chordpro-editor.md has them. A line never wraps: the song scrolls both ways.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.SongPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ApplicationBackgroundBrush}">
  <DockPanel>
    <Border x:Name="Band" DockPanel.Dock="Top" Background="{DynamicResource Pro7.Band}" Padding="10,6">
      <TextBlock x:Name="BandWords" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    </Border>

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="12,6,12,7">
      <TextBlock x:Name="Quiet"
                 FontSize="12.5"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Border>

    <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="16,10,16,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,3">
        <TextBlock x:Name="Key" />
        <TextBlock x:Name="ShownKey" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <TextBlock x:Name="SongName" FontSize="20" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <Border x:Name="UnderTheHeader" DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

    <Grid>
      <TextBlock x:Name="NoSong"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="Problem" Margin="16" TextWrapping="Wrap" VerticalAlignment="Top" />
      <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Lines" Margin="16,12,16,16" HorizontalAlignment="Left" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
