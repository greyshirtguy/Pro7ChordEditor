<!--
  The song that is open, at the right of the window: its name, its key, and its lines
  with their chords in brackets. So far it is only shown, and an earlier version of it
  can be put back. spec/06-library.md, rules 12, 14 and 19; spec/07-backups.md, rules
  15 and 22. The ChordPro editor (M5) and the chord sheet (M6) take the place of the
  lines, and the two keys become pickers then.

    a band     across the top while ProPresenter is running: everything can be looked
               at and nothing changed. It goes by itself when ProPresenter does;
    a header   the song's name; at its right the key it states, if it states one, and
               Earlier Versions, if copies of it are kept;
    the song   its lines (SongLines.cs), or the sentence that says why it could not be
               read, or, with no song open, a few quiet words where it would be;
    a line     at the foot, that says what is there to be seen, or what went wrong.
               After a version has been put back it offers, for a few seconds, to undo
               that; and after a file was found changed by something else, to open the
               song again.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.SongPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pro7ChordEditor.AppViews"
             Background="{DynamicResource ApplicationBackgroundBrush}">
  <DockPanel>
    <Border x:Name="Band" DockPanel.Dock="Top" Background="{DynamicResource Pro7.Band}" Padding="10,6">
      <TextBlock x:Name="BandWords" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    </Border>

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="12,5,12,6">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Undo"
                  Content="Undo"
                  Margin="10,0,0,0"
                  Padding="9,2,9,3"
                  Click="UndoWasClicked"
                  ToolTip="Put the song back as it was a moment ago." />
          <Button x:Name="OpenAgain"
                  Content="Open Again"
                  Margin="10,0,0,0"
                  Padding="9,2,9,3"
                  Click="OpenAgainWasClicked"
                  ToolTip="Read the song afresh from its file, as it is now." />
        </StackPanel>
        <TextBlock x:Name="Quiet" FontSize="12.5" VerticalAlignment="Center" Margin="0,1,0,1" />
      </DockPanel>
    </Border>

    <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="16,10,16,10">
      <Button x:Name="Earlier"
              DockPanel.Dock="Right"
              Content="Earlier Versions"
              Margin="14,0,0,0"
              VerticalAlignment="Center"
              Click="EarlierVersionsWasClicked"
              ToolTip="See this song as it was before it was changed here, and put a version back." />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,3">
        <TextBlock x:Name="Key" />
        <TextBlock x:Name="ShownKey" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <TextBlock x:Name="SongName" FontSize="20" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <Border x:Name="UnderTheHeader" DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

    <Grid>
      <TextBlock x:Name="NoSong"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="Problem" Margin="16" TextWrapping="Wrap" VerticalAlignment="Top" />
      <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
        <views:SongLines x:Name="Lines" Margin="16,12,16,16" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
