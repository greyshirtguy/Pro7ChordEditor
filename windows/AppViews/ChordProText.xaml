<!--
  The ChordPro editor's text: the system's own text box, in a fixed-width font, that
  never wraps; and behind it the same letters drawn in their colours
  (ChordProUnderlay.cs). spec/04-chordpro-editor.md, rules 1, 4 and 6 to 12;
  spec/10-platforms.md: "The ChordPro editor is a plain TextBox".

  The box draws its own letters in no colour, so that only the coloured ones behind it
  are seen; its caret and what is selected are its own, and are seen over them.

  The box's template is this file's and not the look's: a text box of the system's look
  has an edge, a line under it when it has the keyboard, and room kept for both, and
  this one is the whole of the pane it is in. Its scroll bars are the look's.

  What the system would do to text as it is typed is off: its own undo (the code beside
  this says why), and input methods, since only chords are typed here and their names
  are plain letters (NOTES.md says that nobody has tried this with such a keyboard).
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.ChordProText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pro7ChordEditor.AppViews"
             Focusable="False">
  <Grid ClipToBounds="True">
    <views:ChordProUnderlay x:Name="Under"
                            WordsBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            QuietBrush="{DynamicResource TextFillColorSecondaryBrush}"
                            ChordBrush="{DynamicResource Pro7.Chord}" />
    <TextBox x:Name="Box"
             AcceptsReturn="True"
             AcceptsTab="False"
             TextWrapping="NoWrap"
             IsUndoEnabled="False"
             HorizontalScrollBarVisibility="Auto"
             VerticalScrollBarVisibility="Auto"
             FontFamily="Cascadia Mono, Consolas, Courier New"
             Background="Transparent"
             Foreground="Transparent"
             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
             BorderThickness="0"
             Padding="14,10,0,0"
             MinHeight="0"
             IsReadOnlyCaretVisible="True"
             FocusVisualStyle="{x:Null}"
             InputMethod.IsInputMethodEnabled="False"
             AutomationProperties.Name="The song as ChordPro text">
      <TextBox.Template>
        <ControlTemplate TargetType="TextBox">
          <!-- (The box hands its padding to this by itself: said here too, it would be there twice.) -->
          <Border Background="{TemplateBinding Background}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
          </Border>
        </ControlTemplate>
      </TextBox.Template>
    </TextBox>
  </Grid>
</UserControl>
