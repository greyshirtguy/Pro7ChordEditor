<!--
  The left of the window: two lists, one over the other, as ProPresenter has them.
  spec/06-library.md, rules 6a to 11.

    over    where the songs are (a place: ProPresenter's folder, or a folder chosen by
            hand) and that place's libraries;
    under   the songs of the library chosen, with a search box over them and a choice
            that narrows them by mark.

  The bar between the two is dragged up and down, and the two have grounds of different
  greys, the libraries' the lighter (Look.cs). The bar says how many songs the list
  under it has, and has a small grip in its middle to show that it can be dragged.

  The lists, fields and buttons are the system's own. Two things of theirs are changed,
  both by giving the look another answer where it asks (a resource of the same name,
  nearer by): a row is less tall than the look makes one, since a library has hundreds
  of songs; and a list has no ground of its own, so that the pane's grey is seen.

  The small marks after a song's name are letters of the system's own font of signs
  (Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets before it), written here by
  their numbers.

  Nothing here is a rule, and no sentence the person reads is made here but those that
  only name a thing: the rest come from LibraryModel.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.ListsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pro7ChordEditor.AppViews">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Shown" />
    <FontFamily x:Key="Signs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </UserControl.Resources>
  <Grid x:Name="Whole">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="LibrariesRow" Height="200" />
      <RowDefinition x:Name="BarRow" Height="22" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Over: the place, and its libraries. -->
    <DockPanel Grid.Row="0" Background="{DynamicResource Pro7.Libraries}" ClipToBounds="True">
      <StackPanel DockPanel.Dock="Top" Margin="10,10,10,10">
        <TextBlock x:Name="NoPlace" TextWrapping="Wrap" Margin="0,0,0,6" />
        <ComboBox x:Name="Places"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Id"
                  Margin="0,0,0,6"
                  SelectionChanged="APlaceWasPicked" />
        <Button x:Name="Choose"
                Content="Choose Folder&#x2026;"
                HorizontalAlignment="Left"
                Click="ChooseAFolder"
                ToolTip="Open any folder of .pro files: a ProPresenter folder, its Libraries folder, or one library." />
      </StackPanel>
      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <TextBlock DockPanel.Dock="Top"
                 Text="LIBRARIES"
                 FontSize="11"
                 Margin="10,8,10,4"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="NoLibraries"
                 DockPanel.Dock="Top"
                 TextWrapping="Wrap"
                 Margin="10"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <ListBox x:Name="Libraries"
               Background="Transparent"
               BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectedValuePath="Id"
               SelectionChanged="ALibraryWasPicked">
        <ListBox.Resources>
          <Thickness x:Key="ListBoxItemPadding">10,4,8,4</Thickness>
        </ListBox.Resources>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <views:LibraryIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- The bar between the two lists. -->
    <Border x:Name="Bar"
            Grid.Row="1"
            Background="{DynamicResource Pro7.Bar}"
            Cursor="SizeNS"
            ToolTip="Drag up or down to give the libraries or the songs more room."
            MouseLeftButtonDown="TheBarIsPressed"
            MouseMove="TheBarIsMoved"
            MouseLeftButtonUp="TheBarIsLetGo"
            LostMouseCapture="TheBarIsLost"
            MouseEnter="ThePointerIsOverTheBar"
            MouseLeave="ThePointerHasLeftTheBar">
      <Grid>
        <TextBlock x:Name="Count"
                   Margin="10,0"
                   VerticalAlignment="Center"
                   FontSize="10.5"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Border x:Name="Grip"
                Width="30"
                Height="4"
                CornerRadius="2"
                Opacity="0.28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource TextFillColorPrimaryBrush}" />
      </Grid>
    </Border>

    <!-- Under: the songs of the library, a search box over them, and the marks. -->
    <DockPanel Grid.Row="2" Background="{DynamicResource Pro7.Songs}" ClipToBounds="True">
      <StackPanel DockPanel.Dock="Top" Margin="10,10,10,10">
        <Grid>
          <TextBox x:Name="Search" Padding="28,5,28,6" TextChanged="TheSearchWasTyped" />
          <TextBlock Text="&#xE721;"
                     FontFamily="{StaticResource Signs}"
                     FontSize="13"
                     Margin="9,0,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="Hint"
                     Text="Search"
                     Margin="29,0,0,1"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <Button x:Name="Clear"
                  Content="&#xE711;"
                  FontFamily="{StaticResource Signs}"
                  FontSize="10"
                  Padding="6,5,6,5"
                  Margin="0,0,3,0"
                  BorderThickness="0"
                  Background="Transparent"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Focusable="False"
                  Click="TheSearchIsCleared"
                  ToolTip="Clear the search" />
        </Grid>
        <!-- (Each as wide as its words want, so that all three can be read where the lists are at their narrowest.) -->
        <Grid Margin="0,8,0,0" ToolTip="Show every song, only those that have chords, or only those that have none.">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="All" Grid.Column="0" Content="All" HorizontalAlignment="Stretch" Padding="2,4,2,5" Margin="0,0,2,0" Click="AllIsChosen" />
          <ToggleButton x:Name="WithChords" Grid.Column="1" Content="With chords" HorizontalAlignment="Stretch" Padding="2,4,2,5" Margin="1,0,1,0" Click="WithChordsIsChosen" />
          <ToggleButton x:Name="Without" Grid.Column="2" Content="Without" HorizontalAlignment="Stretch" Padding="2,4,2,5" Margin="2,0,0,0" Click="WithoutIsChosen" />
        </Grid>
      </StackPanel>
      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <ListBox x:Name="Songs"
               Background="Transparent"
               BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="ASongWasPicked">
        <ListBox.Resources>
          <Thickness x:Key="ListBoxItemPadding">10,4,8,4</Thickness>
        </ListBox.Resources>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Opacity="{Binding Strength}">
              <views:PresentationIcon DockPanel.Dock="Left"
                                      Width="15"
                                      Height="15"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource TextFillColorSecondaryBrush}" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="{StaticResource Signs}"
                           Margin="5,0,0,0"
                           Background="Transparent"
                           ToolTip="{Binding CannotBeReadTip}"
                           Visibility="{Binding CannotBeRead, Converter={StaticResource Shown}}" />
                <TextBlock Text="&#xE8C8;"
                           FontFamily="{StaticResource Signs}"
                           Margin="5,0,0,0"
                           Background="Transparent"
                           ToolTip="{Binding OldEditorsCopyTip}"
                           Visibility="{Binding IsOldEditorsCopy, Converter={StaticResource Shown}}" />
                <TextBlock Text="&#xEC4F;"
                           FontFamily="{StaticResource Signs}"
                           Margin="5,0,0,0"
                           Background="Transparent"
                           ToolTip="{Binding ChordsTip}"
                           Visibility="{Binding HasChords, Converter={StaticResource Shown}}" />
              </StackPanel>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
