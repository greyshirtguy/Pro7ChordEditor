<!--
  All Copies, in the app's settings: every song that has copies kept, by place and
  library, those whose song is no longer where it was included. From here a copy can be
  looked at, or saved somewhere as a file. spec/07-backups.md, rules 13 and 18.

      songs that have copies | the copies of the one picked | the copy picked, as it was

  and at the foot how much room the copies take, a button that shows their folder, and
  one that saves the copy picked as a file of its own.

  Nothing here changes a song. Putting a copy back is done from the song itself
  (EarlierVersionsPanel), where the song is open and its safeguards are asked.

  What is shown comes from AllCopiesModel, which this view is handed. It has a ground
  of its own and says what colour words are, both the system's: a test draws it with
  no window to have them from.
-->
<UserControl x:Class="Pro7ChordEditor.AppViews.AllCopiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pro7ChordEditor.AppViews"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             UseLayoutRounding="True">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Backups" FontSize="16" FontWeight="SemiBold" Margin="14,12,14,2" />
    <TextBlock x:Name="WhatTheseAre" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="14,4,14,12" />
    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="12,10,12,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ShowFolder"
                  Content="Show Their Folder"
                  Margin="10,0,0,0"
                  Click="ShowTheirFolder"
                  ToolTip="Show in File Explorer the folder the copies are kept in." />
          <Button x:Name="SaveAs"
                  Content="Save This Copy As&#x2026;"
                  Margin="8,0,0,0"
                  Click="SaveThisCopyAs"
                  ToolTip="Save the copy picked as a file of its own. The song in the library is not changed." />
        </StackPanel>
        <TextBlock x:Name="Foot" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </DockPanel>
    </Border>

    <Grid>
      <TextBlock x:Name="None"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <Grid x:Name="Kept">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Songs"
                 Grid.Column="0"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedValuePath="Id"
                 SelectionChanged="ASongWasPicked">
          <ListBox.Resources>
            <Thickness x:Key="ListBoxItemPadding">12,6,10,6</Thickness>
          </ListBox.Resources>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Song.Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Where}"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <ListBox x:Name="Copies"
                 Grid.Column="2"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedValuePath="Id"
                 SelectionChanged="ACopyWasPicked">
          <ListBox.Resources>
            <Thickness x:Key="ListBoxItemPadding">12,6,10,6</Thickness>
          </ListBox.Resources>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Why}"
                           Margin="8,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding When}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="3" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Grid Grid.Column="4">
          <TextBlock x:Name="Problem" Margin="16" TextWrapping="Wrap" VerticalAlignment="Top" />
          <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <views:SongLines x:Name="Lines" Margin="16,12,16,16" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
