<!--
  The tests of the song (../../Song) and of the reader it stands on (../../ProFormat),
  held to testdata/files: the presentations there, clean and damaged, and what
  testdata/files/expected says is in each.

  Nothing here ever writes into testdata/. A test that changes a file works on a copy
  in a temporary folder (AGENTS.md, "The person's files").

    TheReaderTests                the reader of the format, before anything is built on it
    ReadingASongTests             every test file read as Simple Presenter reads it
    ChangingChordsTests           a box's chords set, saved, undone: the proofs of spec/05
    KeysAndRefusalsTests          the two keys; every refusal's sentence, and that it changes nothing
    ChordsWithNoWordsTests        a chord more or fewer on a line with no words; blank slides
    NotHeldByTheTestFilesTests    rules no test file holds, each by a song made for it
    LibraryTests                  finding places, the lists, the marks, the app's own folder, a song as lines
    CopiesTests                   the copies kept before a change, and putting one back: the proofs of spec/07
    ChordProEditorTests           the ChordPro editor with no window: what may be typed, the help with
                                  brackets, what a pause saves
    Workbench                     where they work: copies in a temporary folder

  It is an .exe because xUnit, from its third version, makes every project of tests a
  program that can run itself. `dotnet test` runs it.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Pro7ChordEditor.Song.Tests</AssemblyName>
    <RootNamespace>Pro7ChordEditor.Song.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ChordRules\ChordRules.csproj" />
    <ProjectReference Include="..\..\ProFormat\ProFormat.csproj" />
    <ProjectReference Include="..\..\Song\Song.csproj" />
    <ProjectReference Include="..\TestData\TestData.csproj" />
  </ItemGroup>
</Project>
